{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__ssc__(approve|unapprove)(_.*)?$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/approval-gate.mjs\""
          }
        ]
      },
      {
        "matcher": "^mcp__ssc__(create_campaign|create_adset|create_ad|update_budget)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/approval-gate.mjs\""
          }
        ]
      }
    ]
  }
}
